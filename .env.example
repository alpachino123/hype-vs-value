# Copy this file to .env and fill in your own values
# cp .env.example .env

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=market_research_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# SEC EDGAR Identity (required by SEC fair-use policy)
# Format: "Your Name <your_email@example.com>"
EDGAR_IDENTITY=Your Name <your_email@example.com>

# Tiingo API Keys (free tier at tiingo.com — add up to 5 for rotation)
TIINGO_API_KEY_1=your_tiingo_key_here
TIINGO_API_KEY_2=
TIINGO_API_KEY_3=
TIINGO_API_KEY_4=
TIINGO_API_KEY_5=
